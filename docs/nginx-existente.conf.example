# Exemplo de vhost para o Nginx DO HOST (fora do Docker), a ser usado quando
# a rádio já ocupa as portas 80/443 com um Nginx próprio.
#
# Pré-requisito: publique o gateway do Supabase só em 127.0.0.1 (veja
# docker-compose.override.yml.example na raiz do repo) para não expor a
# porta 8000 direto na internet.
#
# Instalação (Ubuntu/Debian):
#   sudo cp nginx-existente.conf.example /etc/nginx/sites-available/supabase.conf
#   sudo ln -s /etc/nginx/sites-available/supabase.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d supabase.valletibooks.com.br
#   (o certbot reescreve este arquivo adicionando os blocos SSL automaticamente)

upstream supabase_gateway {
    server 127.0.0.1:8000;
    keepalive 2;
}

server {
    listen 80;
    listen [::]:80;
    server_name supabase.valletibooks.com.br;

    # Depois do certbot, este bloco passa a redirecionar para HTTPS.
    # Antes disso, deixe assim para o desafio HTTP-01 do Let's Encrypt passar.

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Port $server_port;

    # Evita 502 com cookies/headers grandes do Auth
    large_client_header_buffers 4 16k;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location / {
        # Proteja o Studio com autenticação básica adicional se quiser
        # (o Supabase já pede DASHBOARD_USERNAME/DASHBOARD_PASSWORD).
        proxy_pass http://supabase_gateway;
    }

    location /realtime/v1/ {
        proxy_pass http://supabase_gateway;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location /storage/v1/ {
        proxy_pass http://supabase_gateway;
        proxy_buffering off;
        proxy_request_buffering off;
        chunked_transfer_encoding off;
        client_max_body_size 0;
    }
}
